# Copy this file to .env and fill in your own values. Never commit .env.

# Telegram — from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Any random string; Telegram sends it back so we know webhook calls are real
TELEGRAM_WEBHOOK_SECRET=

# Official CPCB air data — free key from https://data.gov.in (My Account → API key)
DATA_GOV_IN_KEY=

# AI for free-text questions — https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Must support tool calling. Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Database — Supabase project settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared secret the GitHub Actions cron sends to /api/tick
CRON_SECRET=
