{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/stats", "destination": "/api/index" },
    { "source": "/api/telegram", "destination": "/api/index" },
    { "source": "/api/tick", "destination": "/api/index" },
    { "source": "/api/stats", "destination": "/api/index" }
  ]
}
